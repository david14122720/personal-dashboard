+    setSelectedDate(null);
+  }
+
+  function goToToday(): void {
+    setMonthKey(todayYmdLocal().slice(0, 7));
+    setSelectedDate(null);
+  }
+
+  function retry(): void {
+    void mutate(TASKS_KEY);
+    void mutate(eventsKey(eventRange.from, eventRange.to));
+  }
